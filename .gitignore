# Workspace-level ignores. Each folder also has its own .gitignore, because
# each folder will become its own repo.

# --- Personal files: Claude Code preferences and private notes ---
CLAUDE.local.md
docs/private/

# --- Real company material: never in this public repo ---
real-cdp-project/

# --- Secrets / env files ---
.env
.env.*

# --- Python, shared virtual environment at the workspace root ---
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# --- Never commit data or local ML state, anywhere ---
data/
outputs/
mlruns/
mlartifacts/
mlflow.db

# --- Terraform working files, anywhere ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# --- Documents ---
*.pdf

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

.real-cdp-project/
